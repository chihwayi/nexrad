# ══════════════════════════════════════════════════════════════
# DEPLOYMENT — change HOST (and secrets) only. Everything derives from it.
# ══════════════════════════════════════════════════════════════
HOST=localhost

# ── Ports ─────────────────────────────────────────────────────
API_PORT=3000
WEB_PORT=5173
DB_PORT=3306
REDIS_PORT=6379

# ── Database ──────────────────────────────────────────────────
DB_ROOT_PASSWORD=CHANGE_ME
DB_USER=radius
DB_PASSWORD=CHANGE_ME
DB_NAME=radius
MYSQL_ROOT_PASSWORD=CHANGE_ME
REDIS_PASSWORD=CHANGE_ME
DOMAIN=localhost
GITHUB_REPO=YOUR_ORG/nexrad

# ── Auth ──────────────────────────────────────────────────────
JWT_SECRET=CHANGE_ME_long_random_string
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=CHANGE_ME_another_long_random_string
REFRESH_TOKEN_EXPIRES_IN=7d

# ── App ───────────────────────────────────────────────────────
APP_NAME=NexRAD
SUPER_ADMIN_EMAIL=admin@nexrad.io
SUPER_ADMIN_PASSWORD=CHANGE_ME

# ── WireGuard ─────────────────────────────────────────────────
WG_INTERFACE=wg0
WG_CONFIG_PATH=/etc/wireguard/wg0.conf
WG_SERVER_PUBLIC_KEY=
API_BASE_URL=http://173.212.195.88  # NexRAD API base URL reachable from MikroTik
WG_SUBNET=10.8.0.0/24
WG_SERVER_IP=10.8.0.1
WG_PORT=51820

# SMTP (optional — leave blank to disable email)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@yourdomain.com

# ── Rate Limiting ─────────────────────────────────────────────
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=60000
