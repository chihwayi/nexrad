# ── Database ─────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=radius
DB_PASSWORD=radiusPassword
DB_NAME=radius

# ── Redis ────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── API ──────────────────────────────────────────────────
API_PORT=3000
API_HOST=0.0.0.0
NODE_ENV=development

# ── Auth ─────────────────────────────────────────────────
JWT_SECRET=change-this-to-a-long-random-string-in-production
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=another-long-random-string-for-refresh-tokens
REFRESH_TOKEN_EXPIRES_IN=7d

# ── Frontend ─────────────────────────────────────────────
VITE_API_URL=http://localhost:3000
VITE_WS_URL=ws://localhost:3000
VITE_APP_NAME=NexRAD

# ── WireGuard ────────────────────────────────────────────
WG_INTERFACE=wg0
WG_CONFIG_PATH=/etc/wireguard/wg0.conf
WG_SERVER_PUBLIC_KEY=
WG_SERVER_ENDPOINT=your-server-ip:51820
WG_SUBNET=10.8.0.0/24
WG_SERVER_IP=10.8.0.1
WG_PORT=51820

# ── Email (optional) ─────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@nexrad.io

# ── App ──────────────────────────────────────────────────
APP_URL=http://localhost:5173
SUPER_ADMIN_EMAIL=admin@nexrad.io
SUPER_ADMIN_PASSWORD=changeme

# ── Rate Limiting ────────────────────────────────────────
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=60000
