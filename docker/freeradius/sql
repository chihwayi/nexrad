sql {
    driver = "rlm_sql_mysql"
    dialect = "mysql"

    server   = "${DB_HOST}"
    port     = 3306
    login    = "${DB_USER}"
    password = "${DB_PASSWORD}"
    radius_db = "${DB_NAME}"

    acct_table1          = "radacct"
    acct_table2          = "radacct"
    postauth_table       = "radpostauth"
    authcheck_table      = "radcheck"
    groupcheck_table     = "radgroupcheck"
    authreply_table      = "radreply"
    groupreply_table     = "radgroupreply"
    usergroup_table      = "radusergroup"
    read_clients         = yes
    nas_table            = "nas"

    read_groups          = yes
    read_profiles        = no
    deletestalesessions  = yes

    pool {
        start       = 5
        min         = 3
        max         = 10
        spare       = 3
        uses        = 0
        lifetime    = 0
        idle_timeout = 60
    }
}
